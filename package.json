{
  "name": "zpcrweb",
  "version": "0.1.0",
  "private": true,
  "description": "Library and web app for reading Bio-Rad CFX qPCR .zpcr files",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @zpcrweb/core",
    "dev": "npm run dev -w @zpcrweb/web",
    "test": "npm run test -w @zpcrweb/core",
    "test:ui": "node tools/uitest.mjs",
    "typecheck": "npm run typecheck -w @zpcrweb/core"
  },
  "license": "GPL-3.0-or-later"
}
